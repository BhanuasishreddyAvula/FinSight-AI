# ── Required ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
VOYAGE_API_KEY=your_voyage_api_key_here
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=your_pinecone_index_name_here
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_revealed_service_role_key_here


# ── Optional ──────────────────────────────────────────────────────────────────
COHERE_API_KEY=your_cohere_api_key_here   # Enables Cohere Rerank (improves retrieval quality)

# ── Model & Tuning Defaults ───────────────────────────────────────────────────
GROQ_MODEL=llama-3.3-70b-versatile
EMBEDDING_MODEL=voyage-finance-2
EMBEDDING_DIMENSION=1024
CHUNK_SIZE=500
CHUNK_OVERLAP=75
TOP_K=5
HYBRID_ALPHA=0.7
MEMORY_WINDOW=5
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=.txt,.docx,.pdf
RATE_LIMIT_QUERIES=20/minute
RATE_LIMIT_UPLOADS=5/minute
ALLOWED_ORIGINS=*
