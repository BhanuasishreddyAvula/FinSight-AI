__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Temp files
*.tmp
*.temp
/tmp/

# Test artifacts
.pytest_cache/
htmlcov/
.coverage
